#!/usr/bin/env bash

if [ -z "${__KEX_TEST__:-}" ]; then
	set -e
	set -o pipefail
fi

main() {
	if ! command -v socat >/dev/null; then
		echo "ERROR kex: socat not found" >&2
		exit 1
	fi

	declare -a args host cmd
	parse_ssh_opts args host cmd "$@"

	local config
	config=$(ssh -G "${args[@]}" "${host[@]}")

	local ssh_sock
	while IFS=' ' read -r key value; do
		case "$key" in
		controlpath)
			ssh_sock=$value
			;;
		esac
	done <<<"$config"

	declare -a tty=()
	if [ ${#cmd[@]} -eq 0 ] && [ -t 0 ]; then
		# wrapping the original ssh remote command (see wrapper()) means ssh sees a command
		# whether the user provided one or not; the pseudo-terminal logic must be
		# reimplemented by providing an overridable (before user args) force opt when remote
		# command is originally not provided
		tty=(-t)
	fi

	T=$(mktemp -d)
	# shellcheck disable=SC2329
	SRV_PID=""
	cleanup() {
		if [ -n "$SRV_PID" ]; then
			kill "$SRV_PID" 2>/dev/null || true
			wait "$SRV_PID" 2>/dev/null || true
		fi
		rm -fr "$T" || true
	}
	trap cleanup EXIT INT TERM

	declare -a extra_opts=()
	if [ -z "${ssh_sock:-}" ]; then
		ssh_sock=$T/master_socket
		extra_opts=(-M -S "$ssh_sock")
	fi

	# TODO: if ControlPath is set, ControlMaster=no and there is no -O forward, then ssh either
	# reuses a connection or makes a new one, and in the latter case, we don't have a socket.
	# Adding -M or -O forward in this case would break intended behavior, while generating a
	# warning would require parsing -O forward out of args, which we should probably implement
	# at some point.

	KEX_SOCK=$T/kex_socket

	__KEX_SSH_SOCK="$ssh_sock" socat UNIX-LISTEN:"$KEX_SOCK",fork,mode=0660 EXEC:"$0" 2>"$T"/socat.log &
	SRV_PID=$!

	KEX_SOCK_REMOTE=/tmp/kex.$RANDOM
	ssh "${tty[@]}" "${args[@]}" -R "$KEX_SOCK_REMOTE":"$KEX_SOCK" "${extra_opts[@]}" "${host[@]}" \
		"$(declare -f wrapper); wrapper" $KEX_SOCK_REMOTE "${cmd[@]}"
}

# Wrap an ssh remote command injecting the 'kex' companion into its environment.
#
# wrapper kex_socket [command [argument ...]]
wrapper() {
	KEX_SOCK="$1"
	shift 1

	T=$(mktemp -d) || exit 1
	trap 'rm -fr -- "$T" "$KEX_SOCK"' EXIT HUP TERM

	cat >"$T"/kex <<-"EOF"
		#!/bin/sh
		printf "%s\n" "$@" | nc -NU "$KEX_SOCK" | while IFS=' ' read -r what line; do
			case "$what" in
			STDOUT) echo "$line" ;;
			STDERR) echo "$line" >&2 ;;
			EXIT) exit "$line" ;;
			esac
		done
	EOF
	chmod +x "$T"/kex

	# shellcheck disable=SC2068
	PATH="$T:$PATH" KEX_SOCK="$KEX_SOCK" ${@:-${SHELL:-/bin/sh}}
	E=$?

	exit "$E"
}

# Parse ssh arguments to divide them into the remote command and other arguments.
#
# parse_ssh_opts OUT_ARGS OUT_HOST_VERBATIM OUT_CMD <ssh arguments>
#
# $OUT_ARGS is guaranteed to not contain "--" as a delimiter, so adding options after $OUT_ARGS
# is possible. If hostname is passed after a "--" delimiter, $OUT_HOST_VERBATIM contains both "--"
# and hostname. Otherwise, $OUT_HOST_VERBATIM is empty and host may be inside $OUT_ARGS.
parse_ssh_opts() {
	# ssh args that take another argument
	local KVS="BbcDEeFIiJLlmOoPpQRSWw"

	local -n out_args=$1 out_host_verbatim=$2 out_cmd=$3
	shift 3

	local host_consumed=0
	out_args=()
	out_host_verbatim=()
	while [ $# -gt 0 ]; do
		if [ "$1" = "--" ]; then
			shift 1
			break
		elif [[ "$1" =~ ^-[^$KVS]*[$KVS]$ ]]; then
			out_args+=("$1")
			shift 1
			if [ $# -gt 0 ]; then
				out_args+=("$1")
				shift 1
			fi
		elif [[ "$1" =~ ^-([^$KVS]+|[^$KVS]*[$KVS].+)$ ]]; then
			out_args+=("$1")
			shift 1
		elif [ "$host_consumed" -eq 0 ]; then
			out_args+=("$1")
			host_consumed=1
			shift 1
		else
			break
		fi
	done
	if [ "$host_consumed" -eq 0 ] && [ $# -gt 0 ]; then
		out_host_verbatim+=("--" "$1")
		shift 1
	fi
	# shellcheck disable=SC2034
	out_cmd=("$@")
}

request_usage() {
	echo "usage:"
	echo -e "\tkex open <url>"
	echo -e "\tkex check|conninfo|channels"
	echo -e "\tkex forward|cancel <ssh forward args...>"
}

# Handle a single request on the local side
#
# request <request args as passed to companion on remote side>
request() {
	ssh_ctl() {
		local ctl_escaped="${__KEX_SSH_SOCK//%/%%}"
		ssh -S "$ctl_escaped" whatever -O "$@"
	}
	case "$1" in
	--help | help | "")
		request_usage
		;;
	open)
		local port
		port=$(sed -nr 's/^https?:\/\/(localhost|127\.0\.0\.1):([0-9]+)([/#?].*|$)/\2/p' <<<"$2")
		if [ -z "$port" ]; then
			port=$(sed -nr 's/^(https?):\/\/(localhost|127\.0\.0\.1)([/#?].*|$)/\1/p' <<<"$2")
			if [ "$port" = http ]; then
				port=80
			elif [ "$port" = https ]; then
				port=443
			fi
		fi
		if [ -n "$port" ]; then
			ssh_ctl forward -L "$port:localhost:$port" || return 1
			# TODO: fall back to other local port on forward error
		fi
		xdg-open "$2"
		;;
	check | conninfo | channels | forward | cancel)
		ssh_ctl "$@"
		;;
	*)
		echo "kex: unknown command"
		request_usage
		return 1
		;;
	esac
}

forward_to_client() {
	local status
	if "$@" 2> >(sed -r 's/^/STDERR /') > >(sed -r 's/^/STDOUT /'); then
		status=0
	else
		status=$?
	fi
	wait || true
	echo EXIT $status
}

if [[ -n "${__KEX_SSH_SOCK:-}" ]]; then
	mapfile -t args
	forward_to_client request "${args[@]}"
elif [ -z "${__KEX_TEST__:-}" ]; then
	main "$@"
fi
