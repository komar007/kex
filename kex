#!/usr/bin/env bash

T=$(mktemp -d)
# shellcheck disable=SC2329
cleanup() {
	rm -fr "$T"
}
trap cleanup EXIT

if [[ "${1:-}" == "__handle" ]]; then
	ssh_ctl() { ssh -S "$SSH_SOCK" whatever -O "$@"; }
	while IFS=" " read -r cmd arg; do
		case "$cmd" in
		OPEN)
			port=$(sed -nr 's/^https?:\/\/(localhost|127.0.0.1)(:([0-9]+))?.*/\3/p' <<<"$arg")
			ssh_ctl forward -L "$port:localhost:$port"
			xdg-open "$arg"
			;;
		FORWARD_REMOTE) ssh_ctl forward -R "$arg" ;;
		FORWARD_LOCAL) ssh_ctl forward -L "$arg" ;;
		UNFORWARD_REMOTE) ssh_ctl cancel -R "$arg" ;;
		UNFORWARD_LOCAL) ssh_ctl cancel -L "$arg" ;;
		esac
	done
	exit 0
fi

KEX_SOCK=$T/kex_socket
SSH_SOCK=$T/master_socket

SSH_SOCK=$SSH_SOCK socat UNIX-LISTEN:"$KEX_SOCK",fork,mode=0660 EXEC:"$0 __handle" &
SRV_PID=$!

KEX_SOCK_REMOTE=/tmp/kex.$RANDOM

ssh -M -S "$SSH_SOCK" -R "$KEX_SOCK_REMOTE":"$KEX_SOCK" "$1" -t '\
	mkdir -p /tmp/kex; \
	cat > /tmp/kex/kex \
<<EOF
	#!/bin/sh

	case "\$1" in
	open)
		echo OPEN "\$2"
		;;
	forward)
		case "\$2" in
		-L) echo FORWARD_LOCAL "\$3" ;;
		-R) echo FORWARD_REMOTE "\$3" ;;
		esac
		;;
	unforward)
		case "\$2" in
		-L) echo UNFORWARD_LOCAL "\$3" ;;
		-R) echo UNFORWARD_REMOTE "\$3" ;;
		esac
		;;
	esac | nc -NU "\$KEX_SOCK"
EOF
	chmod +x /tmp/kex/kex; \
	export PATH="/tmp/kex:$PATH"; \
	export KEX_SOCK='$KEX_SOCK_REMOTE'; \
	${SHELL:-/bin/sh}; \
	E=$?; \
	rm "$KEX_SOCK" -fr; \
	exit "$E" \
'
SSH_STATUS=$?

kill $SRV_PID

exit $SSH_STATUS
