#!/usr/bin/env bash

main() {
	declare host cmd
	declare -a args
	parse_ssh_opts host args cmd "$@"
	declare -a tty=()
	if [ ${#cmd[@]} -eq 0 ] && [ -t 0 ]; then
		# wrapping the original ssh remote command (see wrapper()) means ssh sees a command
		# whether the user provided one or not; the pseudo-terminal logic must be
		# reimplemented by providing an overridable (before user args) force opt when remote
		# command is originally not provided
		tty=(-t)
	fi

	T=$(mktemp -d)
	# shellcheck disable=SC2329
	cleanup() { rm -fr "$T"; }
	trap cleanup EXIT INT TERM

	local ssh_sock
	while IFS=' ' read -r key value; do
		case "$key" in
		controlpath)
			ssh_sock=$value
			;;
		esac
	done < <(ssh -G "${args[@]}" "$host")

	declare -a extra_opts=()
	if [ -z "${ssh_sock:-}" ]; then
		ssh_sock=$T/master_socket
		extra_opts=(-M -S "$ssh_sock")
	fi

	# TODO: if ControlPath is set, ControlMaster=no and there is no -O forward, then ssh either
	# reuses a connection or makes a new one, and in the latter case, we don't have a socket.
	# Adding -M or -O forward in this case would break intended behavior, while generating a
	# warning would require parsing -O forward out of args, which we should probably implement
	# at some point.

	KEX_SOCK=$T/kex_socket

	__KEX_SSH_SOCK="$ssh_sock" socat UNIX-LISTEN:"$KEX_SOCK",fork,mode=0660 EXEC:"$0" &
	SRV_PID=$!

	KEX_SOCK_REMOTE=/tmp/kex.$RANDOM
	ssh "${tty[@]}" "${args[@]}" -R "$KEX_SOCK_REMOTE":"$KEX_SOCK" "${extra_opts[@]}" "$host" \
		"$(declare -f wrapper); wrapper" $KEX_SOCK_REMOTE "${cmd[@]}"
	SSH_STATUS=$?

	kill $SRV_PID
	exit $SSH_STATUS
}

# Wrap an ssh remote command injecting the 'kex' companion into its environment.
#
# wrapper kex_socket [command [argument ...]]
wrapper() {
	KEX_SOCK="$1"
	shift 1

	T=$(mktemp -d) || exit 1
	trap 'rm -fr -- "$T" "$KEX_SOCK"' EXIT HUP TERM

	cat >"$T"/kex <<-"EOF"
		#!/bin/sh
		printf "%s\n" "$@" | nc -NU "$KEX_SOCK"
	EOF
	chmod +x "$T"/kex

	# shellcheck disable=SC2068
	PATH="$T:$PATH" KEX_SOCK="$KEX_SOCK" ${@:-${SHELL:-/bin/sh}}
	E=$?

	exit "$E"
}

# Parse ssh options and divide them into the remote command, hostname and other options.
#
# parse_ssh_opts OUT_HOST OUT_ARGS OUT_CMD <ssh options>
parse_ssh_opts() {
	# ssh args that take another argument
	local KVS="BbcDEeFIiJLlmOoPpQRSWw"

	local -n out_host=$1 out_args=$2 out_cmd=$3
	shift 3
	out_host=
	out_args=()

	while [ $# -gt 0 ]; do
		if [ "$1" = "--" ]; then
			shift 1
			break
		elif [[ "$1" =~ ^-[^$KVS]*[$KVS]$ ]]; then
			out_args+=("$1")
			shift 1
			if [ $# -gt 0 ]; then
				out_args+=("$1")
				shift 1
			fi
		elif [[ "$1" =~ ^-([^$KVS]+|[^$KVS]*[$KVS].+)$ ]]; then
			out_args+=("$1")
			shift 1
		elif [ -z "${out_host:-}" ]; then
			out_host=$1
			shift 1
		else
			break
		fi
	done
	if [ -z "$out_host" ] && [ $# -gt 0 ]; then
		out_host=$1
		shift 1
	fi
	# shellcheck disable=SC2034
	out_cmd=("$@")
}

request_usage() {
	echo "usage:"
	echo -e "\tkex open <url>"
	echo -e "\tkex check|conninfo|channels"
	echo -e "\tkex forward|cancel <ssh forward args...>"
}

# Handle a single request on the local side
#
# request <request args as passed to companion on remote side>
request() {
	# TODO: when __KEX_SSH_SOCK is retrieved from ssh -G, it is TOKEN-expanded, but the result
	# of that expansion may still contain TOKENs, which -S will wrongly expand again. Not sure
	# how to approach this.
	ssh_ctl() { ssh -S "$__KEX_SSH_SOCK" whatever -O "$@"; }
	case "$1" in
	--help | help | "")
		request_usage
		;;
	open)
		port=$(sed -nr 's/^https?:\/\/(localhost|127.0.0.1)(:([0-9]+))?.*/\3/p' <<<"$2")
		ssh_ctl forward -L "$port:localhost:$port"
		xdg-open "$2"
		;;
	check | conninfo | channels | forward | cancel)
		ssh_ctl "$@"
		;;
	*)
		echo "kex: unknown command"
		request_usage
		;;
	esac
}

if [[ -n "${__KEX_SSH_SOCK:-}" ]]; then
	mapfile -t args
	request "${args[@]}"
elif [ -z "${__TEST__:-}" ]; then
	main "$@"
fi
